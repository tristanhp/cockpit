{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "setup": "mkdir -p data && npm run db:push && npm run db:seed",
    "demo:setup": "mkdir -p data && rm -f data/demo.db && DATABASE_URL=file:data/demo.db drizzle-kit push --force && DATABASE_URL=file:data/demo.db tsx src/db/demo.ts",
    "demo": "npm run demo:setup && COCKPIT_DEMO=1 DATABASE_URL=file:data/demo.db next dev -H 127.0.0.1"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@notionhq/client": "^5.28.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^188.0.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
