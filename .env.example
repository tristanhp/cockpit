# Copy to .env.local and fill in. Never commit .env.local.

# Notion: https://www.notion.so/profile/integrations → New internal integration (read content).
# Then share the pages that hold your databases with it: ••• → Connections.
NOTION_TOKEN=

# Linear: Settings → Security & access → Personal API keys
LINEAR_API_KEY=

# Google Cloud console → APIs & Services: enable Google Calendar API, create an OAuth client (Web app)
# with redirect URI http://localhost:3000/api/google/callback, add yourself as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# APP_URL=http://localhost:3000
# DATABASE_URL=file:data/cockpit.db
